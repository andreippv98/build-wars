# Copy to .env.local. Never commit real secrets.

# Local dev database from docker-compose.yml (`pnpm db:up`).
DATABASE_URL=postgres://buildwars:buildwars@127.0.0.1:55433/buildwars

# Where 3D model files are served from. Leave unset for local files in public/models.
# NEXT_PUBLIC_MODELS_BASE_URL=https://cdn.example.com/models

# Set to 1 to reach developer pages (e.g. /dev/models) on a production build. Never on the public site.
# ENABLE_DEV_PAGES=1

# Public origin of the site, used for canonical URLs, the sitemap and structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
